rules_version = '2';
// LocalHive Firestore security rules.
// Server-side jobs (notification dispatcher, admin scripts) use the Admin SDK
// service account, which bypasses these rules entirely.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Platform staff. Membership is granted server-side only.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isApprovedCourier() {
      return signedIn()
        && exists(/databases/$(database)/documents/couriers/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // service account only
    }

    // Approved delivery partners. Claiming a job exposes a stranger's name,
    // phone, home address and handover code, so it cannot be self-service:
    // an admin adds the person here after reviewing their application.
    // Membership is never client-writable.
    match /couriers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // User profile: account type (customer | provider | delivery) and prefs.
    // Admins read the directory to pick a person in the Feature Access
    // console; only the person themselves may write.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Platform configuration, e.g. the admin's role/feature toggle matrix
    // (config/feature_flags). Every signed-in client reads it to know which
    // features its role may use; only admins may change it.
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Per-person feature overrides, layered over the role matrix. A user
    // reads their own; admins read and write anyone's.
    match /user_feature_flags/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // 1:1 conversations between the two sides of an order (customer ↔
    // business owner, customer ↔ delivery partner). Text only; the 250-word
    // conversation cap is enforced in the app, per-message size here.
    match /chats/{chatId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow read: if isParticipant();
      // Either side may refresh header fields (lastMessage, wordCount,
      // names) but never rewrite who the conversation is between.
      allow update: if isParticipant()
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{msgId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if signedIn()
          && request.auth.uid in parentChat().participants;
        allow create: if signedIn()
          && request.auth.uid in parentChat().participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false; // what was said stays said
      }
    }

    // Public marketplace catalog. Only listing owners can create/update
    // their listings; going live (live: true) is admin-only (console).
    match /providers/{providerId} {
      allow read: if true;
      // Trust markers are the platform's to award, never the applicant's.
      // Without pinning these, a shop could create itself already "Verified"
      // with a 5.0 rating and 900 reviews, and an admin flipping live would
      // publish the lie.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.live == false
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('rating', 0) == 0
        && request.resource.data.get('reviews', 0) == 0;
      // Owners edit their listing but cannot publish themselves, cannot
      // transfer it, and cannot award themselves a badge or a rating; admins
      // approve as part of application review.
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.live == resource.data.live
            && request.resource.data.get('verified', false)
                 == resource.data.get('verified', false)
            && request.resource.data.get('rating', 0)
                 == resource.data.get('rating', 0)
            && request.resource.data.get('reviews', 0)
                 == resource.data.get('reviews', 0));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Bookings: customers create their own; readable by the customer or by
    // the owner of the booked provider listing; status updates by either
    // party (provider accepts/completes, customer cancels).
    match /bookings/{bookingId} {
      function isCustomer() {
        return signedIn() && resource.data.userId == request.auth.uid;
      }
      // providerOwnerId is denormalized onto the booking at creation so
      // owner queries are provable without per-doc get() lookups.
      function isProviderOwner() {
        return signedIn() && resource.data.providerOwnerId == request.auth.uid;
      }
      // Money fields are written by the payment worker with the service
      // account, which bypasses these rules. A client must never be able to
      // assert its own order is paid — that is free groceries.
      function noMoneyFields(d) {
        return !d.keys().hasAny(['paymentStatus', 'paidAt', 'paymentIntentId',
                                 'amountCents', 'paymentSessionId',
                                 'stripeAccountId', 'cardBrand']);
      }
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && noMoneyFields(request.resource.data);
      // The delivery partner assigned via delivery_jobs/{bookingId} may
      // advance the order status (Out for delivery / Delivered).
      function isAssignedDeliveryPerson() {
        return signedIn()
          && exists(/databases/$(database)/documents/delivery_jobs/$(bookingId))
          && get(/databases/$(database)/documents/delivery_jobs/$(bookingId))
               .data.deliveryPersonId == request.auth.uid;
      }
      // The assigned partner reads the booking for the customer's phone and
      // the delivery OTP. Those are deliberately NOT on delivery_jobs, which
      // every signed-in partner can browse.
      allow read: if isCustomer() || isProviderOwner()
        || isAssignedDeliveryPerson();
      // Only the fulfilment status, and only by the three parties to the
      // order. Everything to do with money is absent from this list on
      // purpose, so no client can move an order to paid, refunded or
      // disputed however it is signed in.
      allow update: if (isCustomer() || isProviderOwner()
            || isAssignedDeliveryPerson())
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status']);
      allow delete: if false;
    }

    // Delivery job board.
    //
    // Claiming a job unlocks the customer's name, phone, address and handover
    // code on the booking, so the board is limited to couriers an admin has
    // approved. It used to be readable by every signed-in account, which meant
    // anyone could sign up and harvest the home address of every customer with
    // an order out for delivery — and, once orders could ask for help to the
    // door, work out which of those addresses belonged to someone frail.
    //
    // The board therefore carries only what a courier needs to decide whether
    // to take the job: the shop, the goods, the fee, and the neighbourhood.
    // The street address, the note to the courier, the phone number and the
    // OTP all live on the booking, readable only once assigned.
    match /delivery_jobs/{jobId} {
      allow read: if isApprovedCourier()
        || isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.deliveryPersonId == ''
        && !request.resource.data.keys().hasAny(
             ['otp', 'customerPhone', 'customerEmail',
              'dropAddress', 'deliveryNote']);
      // Only an approved courier may claim, and only the assignee may then
      // advance it. The fee is pinned: it is what the platform owes, not
      // something the person being paid gets to edit.
      allow update: if isApprovedCourier()
        && (resource.data.deliveryPersonId == request.auth.uid
            || (resource.data.deliveryPersonId == ''
                && request.resource.data.deliveryPersonId == request.auth.uid))
        && request.resource.data.fee == resource.data.fee
        && request.resource.data.userId == resource.data.userId
        && !request.resource.data.keys().hasAny(
             ['otp', 'customerPhone', 'customerEmail',
              'dropAddress', 'deliveryNote']);
      allow delete: if false;
    }

    // Provider applications: applicants create and track their own;
    // platform admins review them in the in-app Admin console.
    match /provider_applications/{appId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'in_review';
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Only the review fields may change, and only by an admin.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedAt']);
      allow delete: if false;
    }

    // Truck arrival subscriptions: users follow a truck to get "we've
    // arrived" alerts. truckOwnerId is denormalized so the owner can list
    // their followers to fan out notifications.
    match /truck_followers/{fid} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
            || resource.data.truckOwnerId == request.auth.uid);
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Support requests Olivia could not resolve herself. Customers raise and
    // read their own; only staff see the whole queue. Clients never resolve a
    // ticket — that is the service account's job, like the outbox.
    match /support_tickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open';
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    // In-app system check writes a ping here to prove the backend round-trip.
    match /diagnostics/{docId} {
      allow create, read: if signedIn();
      allow update, delete: if false;
    }

    // Notification outbox: clients may only enqueue. Reading/dispatching is
    // the server-side dispatcher's job (Admin SDK).
    // In-app update feed. Each doc is addressed to one uid, who may read it
    // and mark it read. Delivered in the app — no SMS, no per-message cost.
    match /notifications/{noteId} {
      // A notification may only be addressed to the other side of an order
      // the sender is actually party to.
      //
      // This used to be `create: if signedIn()` with a free choice of
      // userId, which meant anyone could drop arbitrary text into a
      // stranger's feed. Harmless-looking until money is involved, at which
      // point it is a phishing channel: "your payment failed, call this
      // number" arriving inside the real app, in the real notification list.
      //
      // The proper home for this is a server-side function, which needs a
      // paid Firebase plan. Until then the pairing is proved here, against
      // the booking itself.
      function partyToBooking() {
        let b = get(/databases/$(database)/documents/bookings/
                    $(request.resource.data.bookingId)).data;
        return (b.userId == request.auth.uid
                || b.providerOwnerId == request.auth.uid)
          && (request.resource.data.userId == b.userId
              || request.resource.data.userId == b.providerOwnerId);
      }
      allow create: if signedIn()
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.read == false
        && partyToBooking();
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['read']);
      allow delete: if false;
    }

    // Stripe webhook receipts, kept so a retried or replayed event is
    // processed exactly once. Written by the payment worker through the
    // service account; no client has any business reading or writing them.
    match /stripe_events/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
